{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "es2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [
      "node",
      "@cloudflare/workers-types"
    ],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true
  },
  "include": [
    "server",
    "src/types.ts"
  ]
}
