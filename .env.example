# このファイルを .env にコピーして、各自のキーを設定してください（.env は git に含めない）
# Financial Modeling Prep（株価・目標価格・決算日） https://site.financialmodelingprep.com/developer/docs
# 未設定の場合はデモデータで表示されます
FMP_API_KEY=

# FRED（CPI・雇用統計・PCE・GDP などの発表予定日） https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Claude（スクショからのティッカー読み取り）。未設定ならブラウザ内 OCR（Tesseract.js）を使用
ANTHROPIC_API_KEY=

# API サーバーのポート（任意）
# API_PORT=8787

# Exa（相談チャットのウェブ検索） https://exa.ai
EXA_API_KEY=

# Tavily（相談チャットのウェブ検索。Exa と併用） https://tavily.com
TAVILY_API_KEY=

# SEC EDGAR（有名投資家の 13F）。キーは不要ですが、SEC は連絡先入りの User-Agent を求めます
# 例: SEC_USER_AGENT="Shiome あなたの名前 you@example.com"
SEC_USER_AGENT=

# Finnhub（リアルタイム株価の配信・市場全体の決算/IPO・休場日・同業他社・役員の売買センチメント） https://finnhub.io
FINNHUB_API_KEY=
