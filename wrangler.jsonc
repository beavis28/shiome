{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shiome",
  "main": "server/worker.ts",
  "compatibility_date": "2026-11-01",
  // yahoo-finance2・Anthropic SDK が Node の API を使うため。process.env にも Secret が入る
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // /api/* だけ Worker で処理し、それ以外（画面）は静的ファイルとして配信
    "run_worker_first": ["/api/*"]
  },
  // 日足・目標価格・決算日などのキャッシュ（初回デプロイ時に自動作成されます）
  // 自分の環境の値（KV の id・Access の値）は wrangler.local.jsonc に書くと、npm run deploy がそちらを使います
  "kv_namespaces": [{ "binding": "CACHE" }],
  "vars": {
    // Cloudflare Access を設定したら、下の 2 つを入れて再デプロイしてください
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  // 公開 URL は workers.dev の 1 つだけにする（プレビュー URL は Access の対象外になりやすいため無効）
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
