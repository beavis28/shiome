{
  "name": "shiome",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch server/node.ts\" \"vite\"",
    "dev:api": "tsx watch server/node.ts",
    "dev:web": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "start": "tsx server/node.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "cf:dev": "vite build && wrangler dev -c $(test -f wrangler.local.jsonc && echo wrangler.local.jsonc || echo wrangler.jsonc) --port 8788 --var ALLOW_PUBLIC:1",
    "deploy": "vite build && wrangler deploy -c $(test -f wrangler.local.jsonc && echo wrangler.local.jsonc || echo wrangler.jsonc)",
    "cf:types": "wrangler types --env-interface CloudflareEnv"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@hono/node-server": "^2.1.11",
    "chart.js": "^4.6.2",
    "dotenv": "^18.0.10",
    "hono": "^4.13.21",
    "jose": "^6.2.18",
    "lightweight-charts": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "three": "^0.187.0",
    "tough-cookie": "^6.1.0",
    "yahoo-finance2": "^4.0.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.167.0"
  },
  "license": "MIT",
  "description": "A one-screen US stock watchlist dashboard: prices, analyst targets, technicals, earnings and economic calendar.",
  "repository": {
    "type": "git",
    "url": "https://github.com/beavis28/shiome.git"
  }
}
